# Modèle rendu par l'image nginx officielle : ${DOMAINE} est remplacé au démarrage ($ doublés = variables nginx).
# Sans certificat (premier démarrage), utiliser nginx/nginx-http.conf.template (voir DEPLOIEMENT.md).
gzip on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_types text/plain text/css application/javascript application/json image/svg+xml text/csv;

server {
    listen 80;
    server_name ${DOMAINE};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAINE};

    ssl_certificate     /etc/letsencrypt/live/${DOMAINE}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAINE}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # Plans en base64 (rendus IA) : corps de requête jusqu'à 12 Mo.
    client_max_body_size 12m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;   # génération IA et rendus d'images
    }

    # Fichiers à nom haché : cache d'un an. index.html : toujours revalidé.
    location /assets/ {
        proxy_pass http://frontend:80;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        proxy_pass http://frontend:80;
        add_header Cache-Control "no-cache";
    }
}
