# Copier en .env (jamais versionné) puis remplir. Aucune clé n'est jamais écrite dans le code ni dans les logs.
DOMAINE=plans.exemple.cd
POSTGRES_PASSWORD=
# Supabase (facultatif, voir SUPABASE.md) : base de données et stockage des images
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=rendus
# 32 caractères minimum : openssl rand -hex 32
JWT_SECRET=
# Compte qui devient administrateur à son inscription (facultatif)
ADMIN_EMAIL=
# IA texte (interprétation, auto-correction, explications). Vide = analyseur par règles seul.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# IA image (Nano Banana). Vide = rendus désactivés.
GEMINI_API_KEY=
NANO_BANANA_MODEL=gemini-nano-banana-2.1
RENDUS_MAX_PAR_JOUR=10
API_WORKERS=2
